{
  "name": "gunraid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 20",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency 1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @gunraid/db generate",
    "db:migrate": "pnpm --filter @gunraid/db migrate",
    "db:seed": "pnpm --filter @gunraid/db seed",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
